# TraceGuard production SSO configuration blueprint
#
# The current synthetic lab does NOT read this file and does not implement
# OIDC, sessions, or customer access. This template documents values a future
# server-side deployment must receive from a secrets manager or deployment
# platform. Never put production values in frontend code, `dist/`, commits,
# screenshots, tickets, or chat messages.

# Public service origin. Use an HTTPS domain controlled by the organization.
TRACEGUARD_PUBLIC_ORIGIN=https://traceguard.example.example

# Production mode must reject insecure cookies, local demo-role selection, and
# non-HTTPS redirect URIs. This is a future-server setting, not a lab feature.
TRACEGUARD_ENV=production

# OIDC: use the authorization-code flow with PKCE. Configure one exact issuer
# and one exact organization tenant; never use a multi-tenant `common` issuer
# for a tenant-restricted deployment.
TRACEGUARD_OIDC_PROVIDER=entra
TRACEGUARD_OIDC_ISSUER=https://login.microsoftonline.com/<directory-tenant-id>/v2.0
TRACEGUARD_OIDC_CLIENT_ID=<application-client-id>
TRACEGUARD_OIDC_REDIRECT_URI=https://traceguard.example.example/auth/oidc/callback
TRACEGUARD_OIDC_POST_LOGOUT_REDIRECT_URI=https://traceguard.example.example/sign-in
TRACEGUARD_OIDC_EXPECTED_TENANT_ID=<directory-tenant-id>
TRACEGUARD_OIDC_EXPECTED_AUDIENCE=<application-client-id>

# Keep a confidential-client secret or certificate only in the deployment
# secret manager. Leave these placeholders unchanged in source control. Do
# not expose a client secret to the browser.
TRACEGUARD_OIDC_CLIENT_SECRET=<stored-only-in-secret-manager>
TRACEGUARD_SESSION_SECRET=<stored-only-in-secret-manager>

# Map stable, administrator-managed IdP identifiers to TraceGuard roles on
# the SERVER. Prefer Entra app-role values or immutable group IDs, never an
# email address, display name, or browser-selected role. During the pilot,
# only these two roles can be granted.
TRACEGUARD_OIDC_ROLE_CLAIM=roles
TRACEGUARD_OWNER_ROLE_VALUE=traceguard.owner
TRACEGUARD_LAB_ASSISTANT_ROLE_VALUE=traceguard.lab_assistant

# Session policy belongs on the server. These placeholder limits are reviewed
# deployment settings, not a promise made by the local lab. The server must
# rotate session identifiers at sign-in, store only server-side session state,
# and allow immediate revocation.
TRACEGUARD_SESSION_IDLE_MINUTES=30
TRACEGUARD_SESSION_ABSOLUTE_HOURS=8
TRACEGUARD_REQUIRE_STEP_UP_FOR=access_changes,exports,policy_changes,privileged_recovery

# Configure passwordless/passkey or other phishing-resistant MFA in the
# identity provider for Organization Owners. Authenticator-app TOTP can be a
# controlled fallback when policy permits. SMS/phone OTP and Wi-Fi/network
# presence must never be the sole authentication factor.
